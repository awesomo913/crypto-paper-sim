{
 "nickname": "LiveAggressiveRSI-1m-PAPER",
 "goal": "Maximum-churn RSI on 1m candles: shortest Binance spot interval in GCT, sim-only orders (real-orders false). Tune rsi-* after this run.",
 "strategy-settings": {
  "name": "rsi",
  "use-simultaneous-signal-processing": false,
  "disable-usd-tracking": false,
  "custom-settings": {
   "rsi-high": 53,
   "rsi-low": 47,
   "rsi-period": 3
  }
 },
 "funding-settings": {
  "use-exchange-level-funding": false
 },
 "currency-settings": [
  {
   "exchange-name": "binance",
   "asset": "spot",
   "base": "BTC",
   "quote": "USDT",
   "spot-details": {
    "initial-quote-funds": "1000"
   },
   "buy-side": {
    "minimum-size": "0.00001",
    "maximum-size": "5",
    "maximum-total": "1000"
   },
   "sell-side": {
    "minimum-size": "0.00001",
    "maximum-size": "5",
    "maximum-total": "1000"
   },
   "min-slippage-percent": "0",
   "max-slippage-percent": "0.1",
   "maker-fee-override": "0.0002",
   "taker-fee-override": "0.0007",
   "maximum-holdings-ratio": "0",
   "skip-candle-volume-fitting": false,
   "use-exchange-order-limits": true,
   "use-exchange-pnl-calculation": false
  }
 ],
 "data-settings": {
  "interval": 60000000000,
  "data-type": "candle",
  "verbose-exchange-requests": false,
  "live-data": {
   "new-event-timeout": 180000000000,
   "data-check-timer": 2000000000,
   "real-orders": false,
   "close-positions-on-stop": true,
   "data-request-retry-tolerance": 5,
   "data-request-retry-wait-time": 2000000000,
   "exchange-credentials": [
    {
     "exchange": "binance",
     "credentials": {
      "Key": "",
      "Secret": "",
      "ClientID": "",
      "PEMKey": "",
      "SubAccount": "",
      "OneTimePassword": ""
     }
    }
   ]
  }
 },
 "portfolio-settings": {
  "leverage": {
   "can-use-leverage": false,
   "maximum-orders-with-leverage-ratio": "0",
   "maximum-leverage-rate": "0",
   "maximum-collateral-leverage-rate": "0"
  },
  "buy-side": {
   "minimum-size": "0.00001",
   "maximum-size": "5",
   "maximum-total": "1000"
  },
  "sell-side": {
   "minimum-size": "0.00001",
   "maximum-size": "5",
   "maximum-total": "1000"
  }
 },
 "statistic-settings": {
  "risk-free-rate": "0.03"
 }
}
